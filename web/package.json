{
  "name": "@daweifu/capability-menu-web",
  "description": "Browser half of capability-menu: the 能力菜单 (Capability Menu) settings tab — Exposed/Progressive/Blocked classification with click-to-cycle + read-only list + skill file browsing, backed by the Host ctx.capabilityPolicy remote gateway.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/ensure-deps.mjs && tsdown && tsc -p tsconfig.build.json",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "prepare": "npm run build"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PKUfudawei/dsh-capability-menu.git",
    "directory": "web"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-schema-form": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-web-react": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "react": "^18.2.0"
  }
}
